# StudyMate AI - Environment Configuration
# Copy this file to .env and fill in values

# OpenAI API Key (optional - demo mode works without it)
OPENAI_API_KEY=

# Database (SQLite used by default for prototype)
DATABASE_URL=sqlite:///./studymate.db

# Models
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o

# Server
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Demo Mode (auto-enabled when no API key)
DEMO_MODE=true
